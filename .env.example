# ---- Likhakriti AI environment ----
# AI provider: "anthropic", "openai" (any OpenAI-compatible API: OpenAI, Groq, OpenRouter, Together, Ollama),
# or "local" (offline heuristic engine, no key needed — demo mode).
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_KEY=
# OpenAI-compatible (only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional image generation (OpenAI images). Leave empty to use the built-in procedural artwork.
IMAGE_PROVIDER=

# Auth secret for session cookies (any long random string). REQUIRED in production.
AUTH_SECRET=
# Comma-separated emails that get admin access (first registered user is admin otherwise)
ADMIN_EMAILS=

# Public site URL (share links / portfolio URLs / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Database (libSQL) ----
# Local dev: file database (default ./data/likhakriti.db)
DATABASE_PATH=
# Production on Vercel: Turso (https://turso.tech) — free tier is enough to start
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

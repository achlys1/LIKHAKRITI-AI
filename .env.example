# ---- Likhakriti AI environment ----
# AI provider: "openrouter" (default — free router, no paid key), "openai" (any OpenAI-compatible API),
# "anthropic", or "local" (offline heuristic engine, no key needed).
# If the remote provider fails, is rate-limited, or the free quota is exhausted, the app
# automatically falls back to the local offline engine — users never see a blank screen.
AI_PROVIDER=openrouter
# Free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# "openrouter/free" routes each request to a currently-available free model.
# Or pin one, e.g. meta-llama/llama-3.3-70b-instruct:free
AI_MODEL=openrouter/free
# Optional ordered fallbacks tried by OpenRouter before we drop to local (comma-separated)
OPENROUTER_FALLBACK_MODELS=
# Anthropic (only if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# OpenAI-compatible (only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional image generation (OpenAI images). Leave empty to use the built-in procedural artwork.
IMAGE_PROVIDER=

# Auth secret for session cookies (any long random string). REQUIRED in production.
AUTH_SECRET=
# Comma-separated emails that get admin access (first registered user is admin otherwise)
ADMIN_EMAILS=

# Public site URL (share links / portfolio URLs / sitemap / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). The gtag scripts are
# rendered server-side into every page's <head>. Leave empty to keep analytics off.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML tag verification code (meta tag content)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=dWFqMfFtQ_Z_ke6qxlnD39mzxsFRKgvd7ztusYaBCWU

# ---- Database (libSQL) ----
# Local dev: file database (default ./data/likhakriti.db)
DATABASE_PATH=
# Production on Vercel: Turso (https://turso.tech) — free tier is enough to start
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
